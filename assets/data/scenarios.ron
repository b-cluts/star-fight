// Scenario presets offered to the host before a game. Numbers may be
// adjusted on the setup screen. `players` 2-4; `teams` lists each seat's
// side (empty = every seat its own side).
(
    scenarios: [
        (id: "dogfight", name: "Standard dogfight",
         description: "100-point squads on a 20x20 board with six asteroids scattered by the rules' spacing.",
         asteroids: 6),
        (id: "open", name: "Open space",
         description: "No obstacles at all: pure maneuver and gunnery.",
         asteroids: 0),
        (id: "dense", name: "Dense asteroid field",
         description: "Ten asteroids; every approach has to thread rocks.",
         asteroids: 10),
        (id: "debris", name: "Debris run",
         description: "Three asteroids and three debris clouds: debris stresses ships that cross it instead of costing the action.",
         asteroids: 3, debris: 3),
        (id: "skirmish", name: "Skirmish (60 points)",
         description: "Small squads for a quick game; three asteroids.",
         points: 60, asteroids: 3),
        (id: "horizon", name: "Event horizon",
         description: "A black hole in the middle: every ship within Range 5 is dragged one unit toward it after all moves, and touching the core is the end. Three asteroids around it.",
         asteroids: 3, black_holes: 1),
        (id: "grand", name: "Grand battle (150 points)",
         description: "Big squads on a 24x24 board with eight asteroids.",
         points: 150, asteroids: 8, board_width: 24, board_height: 24),
        (id: "teams", name: "Team battle (2 vs 2)",
         description: "Four players in two teams (core rules p.20): each side shares 100 points between its two players, deploys on the same edge and wins together. Six asteroids.",
         players: 4, teams: [0, 0, 1, 1], asteroids: 6),
        (id: "outnumbered", name: "Outnumbered (1 vs 2)",
         description: "One 100-point squad against two 50-point squads on the far edge. Four asteroids.",
         players: 3, teams: [0, 1, 1], asteroids: 4),
        (id: "threeway", name: "Three-way free-for-all",
         description: "Three sides, 60 points each, deploying south, north and east. Last side flying wins. Four asteroids.",
         players: 3, points: 60, asteroids: 4),
        (id: "fourway", name: "Four-way free-for-all",
         description: "Four sides, 60 points each, one on every edge of a 24x24 board. Last side flying wins. Six asteroids.",
         players: 4, points: 60, asteroids: 6, board_width: 24, board_height: 24),
    ],
)

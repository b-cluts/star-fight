// Maneuver sets ("dials") per ship. Difficulty colors: Easy = blue
// (removes a stress token), Normal = white, Hard = red (adds a stress
// token; unavailable while stressed).
(
    sets: [
        (
            id: 1, // TIE/ln Fighter dial (First Edition card): hard 1-turns,
                   // green only on the 2 and 3 straights, red K-turns 3 and 4.
            maneuvers: [
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Normal),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Normal),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: KTurn,     distance: 3, difficulty: Hard),
                (steer: Straight,  distance: 4, difficulty: Normal),
                (steer: KTurn,     distance: 4, difficulty: Hard),
                (steer: Straight,  distance: 5, difficulty: Normal),
            ],
        ),
        (
            id: 2, // T-70 X-Wing dial (First Edition card)
            maneuvers: [
                // Speed 1: straight and banks green; no hard turns.
                (steer: BankLeft,  distance: 1, difficulty: Easy),
                (steer: Straight,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Easy),
                // Speed 2: turns white, banks and straight green.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                // Speed 3: straight green, turns and banks white, red Tallon rolls.
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: TallonLeft,  distance: 3, difficulty: Hard),
                (steer: TallonRight, distance: 3, difficulty: Hard),
                // Speed 4: straight white, red Koiogran (no 4-turns on the card).
                (steer: Straight,  distance: 4, difficulty: Normal),
                (steer: KTurn,     distance: 4, difficulty: Hard),
            ],
        ),
        (
            id: 3, // TIE/fo dial (First Edition card)
            maneuvers: [
                // Speed 1: turns white, banks green.
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: BankLeft,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Easy),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                // Speed 2: turns white, banks and straight green.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                // Speed 3: straight green, everything else white; red
                // Segnor's loops (bank then flip).
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: SegnorLeft,  distance: 3, difficulty: Hard),
                (steer: SegnorRight, distance: 3, difficulty: Hard),
                // Speed 4: straight white, Koiogran red.
                (steer: Straight, distance: 4, difficulty: Normal),
                (steer: KTurn,    distance: 4, difficulty: Hard),
                // Speed 5: straight white.
                (steer: Straight, distance: 5, difficulty: Normal),
            ],
        ),
        (
            id: 4, // BTL-A4 Y-Wing dial (First Edition card)
            maneuvers: [
                // Speed 1: straight green, everything else white.
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: BankLeft,  distance: 1, difficulty: Normal),
                (steer: Straight,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Normal),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                // Speed 2: banks and straight green, turns white.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                // Speed 3: turns red, banks and straight white, red K-turn.
                (steer: TurnLeft,  distance: 3, difficulty: Hard),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Normal),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Hard),
                (steer: KTurn,     distance: 3, difficulty: Hard),
                // Speed 4: straight white, Koiogran red.
                (steer: Straight, distance: 4, difficulty: Normal),
                (steer: KTurn,    distance: 4, difficulty: Hard),
            ],
        ),
        (
            id: 5, // RZ-1 A-Wing dial (First Edition card)
            maneuvers: [
                // Speed 1: turns and banks white, no straight.
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: BankLeft,  distance: 1, difficulty: Normal),
                (steer: BankRight, distance: 1, difficulty: Normal),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                // Speed 2: banks and straight green, turns white.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                // Speed 3: banks and straight green, turns white, red K-turn.
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Easy),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Easy),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: KTurn,     distance: 3, difficulty: Hard),
                // Speed 4 and 5: straights white, red 5 K-turn.
                (steer: Straight, distance: 4, difficulty: Normal),
                (steer: Straight, distance: 5, difficulty: Normal),
                (steer: KTurn,    distance: 5, difficulty: Hard),
            ],
        ),
        (
            id: 6, // YT-1300 dial (First Edition card)
            maneuvers: [
                // Speed 1: banks and straight green, turns white.
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: BankLeft,  distance: 1, difficulty: Easy),
                (steer: Straight,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Easy),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                // Speed 2: banks and straight green, turns white.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                // Speed 3: all white, red K-turn.
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Normal),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: KTurn,     distance: 3, difficulty: Hard),
                // Speed 4: straight white, Koiogran red.
                (steer: Straight, distance: 4, difficulty: Normal),
                (steer: KTurn,    distance: 4, difficulty: Hard),
            ],
        ),
        (
            id: 7, // TIE Bomber dial (First Edition card)
            maneuvers: [
                // Speed 1: banks white, straight green (no hard turns).
                (steer: BankLeft,  distance: 1, difficulty: Normal),
                (steer: Straight,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Normal),
                // Speed 2: turns white, banks and straight green, red K-turn.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                (steer: KTurn,     distance: 2, difficulty: Hard),
                // Speed 3: all white.
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Normal),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                // Speed 4 and 5: straights white, red 5 K-turn.
                (steer: Straight, distance: 4, difficulty: Normal),
                (steer: Straight, distance: 5, difficulty: Normal),
                (steer: KTurn,    distance: 5, difficulty: Hard),
            ],
        ),
        (
            id: 8, // TIE Advanced x1 dial (First Edition card)
            maneuvers: [
                // Speed 1: turns white, banks green (no straight).
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: BankLeft,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Easy),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                // Speed 2: turns white, banks and straight green.
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                // Speed 3: straight green, the rest white, red K-turn.
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: KTurn,     distance: 3, difficulty: Hard),
                // Speed 4: straight white, Koiogran red; speed 5 straight white.
                (steer: Straight, distance: 4, difficulty: Normal),
                (steer: KTurn,    distance: 4, difficulty: Hard),
                (steer: Straight, distance: 5, difficulty: Normal),
            ],
        ),
        (
            id: 9, // TIE Interceptor dial, read from a photo of the First
                   // Edition dial (SWX09): hard 1-turns only; the whole
                   // speed-2 row green; 3 turns and banks white, 3 straight
                   // green, red K-turn 3; green 4 straight; white 5 straight
                   // and red K-turn 5.
            maneuvers: [
                (steer: TurnLeft,  distance: 1, difficulty: Normal),
                (steer: TurnRight, distance: 1, difficulty: Normal),
                (steer: TurnLeft,  distance: 2, difficulty: Easy),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Easy),
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: KTurn,     distance: 3, difficulty: Hard),
                (steer: Straight,  distance: 4, difficulty: Easy),
                (steer: Straight,  distance: 5, difficulty: Normal),
                (steer: KTurn,     distance: 5, difficulty: Hard),
            ],
        ),
        (
            id: 10, // Lambda-class shuttle dial (First Edition card)
            maneuvers: [
                // Speed 0: the red stationary maneuver.
                (steer: Straight,  distance: 0, difficulty: Hard),
                // Speed 1: banks white, straight green.
                (steer: BankLeft,  distance: 1, difficulty: Normal),
                (steer: Straight,  distance: 1, difficulty: Easy),
                (steer: BankRight, distance: 1, difficulty: Normal),
                // Speed 2: turns red, banks white, straight green.
                (steer: TurnLeft,  distance: 2, difficulty: Hard),
                (steer: BankLeft,  distance: 2, difficulty: Normal),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Normal),
                (steer: TurnRight, distance: 2, difficulty: Hard),
                // Speed 3: banks red, straight white. Nothing faster.
                (steer: BankLeft,  distance: 3, difficulty: Hard),
                (steer: Straight,  distance: 3, difficulty: Normal),
                (steer: BankRight, distance: 3, difficulty: Hard),
            ],
        ),
        (
            id: 11, // T-65 X-Wing dial (First Edition card): no straight 1.
            maneuvers: [
                (steer: BankLeft,  distance: 1, difficulty: Normal),
                (steer: BankRight, distance: 1, difficulty: Normal),
                (steer: TurnLeft,  distance: 2, difficulty: Normal),
                (steer: BankLeft,  distance: 2, difficulty: Easy),
                (steer: Straight,  distance: 2, difficulty: Easy),
                (steer: BankRight, distance: 2, difficulty: Easy),
                (steer: TurnRight, distance: 2, difficulty: Normal),
                (steer: TurnLeft,  distance: 3, difficulty: Normal),
                (steer: BankLeft,  distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 3, difficulty: Easy),
                (steer: BankRight, distance: 3, difficulty: Normal),
                (steer: TurnRight, distance: 3, difficulty: Normal),
                (steer: Straight,  distance: 4, difficulty: Normal),
                (steer: KTurn,     distance: 4, difficulty: Hard),
            ],
        ),
        (
            id: 12, // Senator's shuttle (mission 1): may stay, or fly
                    // bank 1 left/right or straight 2 (core rules p.22).
            maneuvers: [
                (steer: Straight,  distance: 0, difficulty: Normal),
                (steer: BankLeft,  distance: 1, difficulty: Normal),
                (steer: Straight,  distance: 2, difficulty: Normal),
                (steer: BankRight, distance: 1, difficulty: Normal),
            ],
        ),
    ],
)

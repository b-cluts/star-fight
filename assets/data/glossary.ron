// In-game glossary: tokens, actions, damage cards and rules terms.
// Ship classes, pilots and upgrade cards are listed from their own files.
// Texts describe the rules as Star Fight plays them.
(
    entries: [
        // ---------------- Tokens ----------------
        (category: Tokens, name: "Focus token",
         text: "Gained by the focus action (and some abilities). When you attack or defend it is spent automatically to turn every focus (eye) result into a hit or an evade. Unspent focus tokens are removed in the End phase."),
        (category: Tokens, name: "Evade token",
         text: "Gained by the evade action. When you defend it is spent to add one evade result if damage would otherwise get through. Removed in the End phase."),
        (category: Tokens, name: "Stress token",
         text: "Received for flying a red maneuver and from some effects. A stressed ship cannot perform actions and cannot plan a red maneuver. Flying a green maneuver removes one stress token. Stress is kept between rounds."),
        (category: Tokens, name: "Target lock",
         text: "Acquired with the target lock action on an enemy ship within Range 1-3, in any direction. It stays until spent or replaced. When you attack that ship it is spent to reroll blank (and, without a focus token, eye) results. Torpedoes and most missiles can only be fired at the ship you have locked, and spend the lock to fire."),
        (category: Tokens, name: "Ion token",
         text: "Assigned by ion weapons and ion bombs. A ship holding ion tokens ignores its dial next round: it flies a white straight 1, then all its ion tokens are removed."),
        (category: Tokens, name: "Shields, hull and critical hits",
         text: "Damage removes shields first, then hull points. Only damage that reaches the hull can be critical: each critical hit that gets through draws one damage card effect (see the Damage tab). A ship with no hull left is destroyed. A faceup damage card dealt directly (Proton Bombs, Advanced Homing Missiles) ignores shields."),
        (category: Tokens, name: "Bomb and mine tokens",
         text: "Dropped one straight-1 template behind the ship. Bombs (Proton, Seismic, Ion, Thermal) are dropped when the dial is revealed, before moving, and detonate at the end of the Activation phase against every ship within Range 1, friend or foe. Mines (Proximity, Cluster, Conner Net) are dropped as an action after moving and stay on the board until a ship's base or template crosses them."),

        // ---------------- Actions ----------------
        (category: Actions, name: "Perform Action step",
         text: "Right after its maneuver each ship may perform one action from its action bar (planned secretly with the maneuver). A ship that is stressed, that bumped into another ship, or that has a Damaged Sensor Array forfeits its action."),
        (category: Actions, name: "Focus (action)",
         text: "Assign one focus token to your ship (key 2 while planning)."),
        (category: Actions, name: "Evade (action)",
         text: "Assign one evade token to your ship (key 3)."),
        (category: Actions, name: "Target lock (action)",
         text: "Lock an enemy ship within Range 1-3 after your move (key 6, then click the enemy). If the chosen ship is out of range after moving, the action fails and the round's event log says so."),
        (category: Actions, name: "Barrel roll (action)",
         text: "Shift sideways by one straight-1 template plus your base width, keeping your heading (keys 4 / 5 for left / right). Fails if it would overlap a ship or leave the board. Zeta Ace may use the straight-2 template ([ / ]); Lieutenant Lorrir may use the bank-1 templates for a stress token (; / ' bending forward, with Shift bending backward), which turns the ship 45 degrees. Expert Handling lets a ship without the icon roll (for a stress) and then removes one enemy target lock from it."),
        (category: Actions, name: "Boost (action)",
         text: "Fly a straight-1 or bank-1 template forward without it counting as a maneuver (keys 7 / 8 / 9 for straight / bank left / bank right). Fails if it would overlap a ship or leave the board."),
        (category: Actions, name: "Seismic Torpedo (card action)",
         text: "Key K until the torpedo is offered, then click an obstacle. After your ship moves, the obstacle must be at Range 1-2 inside your primary firing arc: the card is discarded, every ship at Range 1 of the obstacle (yours included) rolls one attack die and suffers any damage or critical rolled, and the obstacle is removed from the board. A black hole can be blasted too."),
        (category: Actions, name: "Drop mine (card action)",
         text: "Discard a mine card (Proximity Mines, Cluster Mines, Conner Net) to place its token(s) behind your ship (key M cycles the mine to drop). Bombs that drop on dial reveal are chosen with key B instead and do not use the action."),

        // ---------------- Damage cards ----------------
        (category: Damage, name: "Blinded Pilot",
         text: "Pilot. Your next attack rolls no dice; then the card is discarded."),
        (category: Damage, name: "Console Fire",
         text: "Ship. At the start of each Combat phase roll one attack die: on a hit you suffer 1 damage. Stays until the ship is destroyed."),
        (category: Damage, name: "Damaged Cockpit",
         text: "Pilot. Your pilot skill is treated as 0: you move first and fire last."),
        (category: Damage, name: "Damaged Engine",
         text: "Ship. Treat all your turn (90°) maneuvers as red."),
        (category: Damage, name: "Damaged Sensor Array",
         text: "Ship. You cannot perform any action from your action bar."),
        (category: Damage, name: "Direct Hit!",
         text: "Ship. Suffer 1 additional damage immediately."),
        (category: Damage, name: "Injured Pilot",
         text: "Pilot. Your pilot ability no longer works."),
        (category: Damage, name: "Minor Explosion",
         text: "Ship. Roll one attack die immediately: on a hit suffer 1 damage. Then the card has no further effect."),
        (category: Damage, name: "Minor Hull Breach",
         text: "Ship. After you fly a red maneuver, roll one attack die: on a hit suffer 1 damage."),
        (category: Damage, name: "Stunned Pilot",
         text: "Pilot. Whenever you bump into another ship you suffer 1 damage."),
        (category: Damage, name: "Thrust Control Fire",
         text: "Ship. Treat all your bank maneuvers as red."),
        (category: Damage, name: "Weapon Malfunction",
         text: "Ship. Roll one fewer attack die with every attack."),
        (category: Damage, name: "Weapons Failure",
         text: "Ship. You cannot attack at all for two rounds; then the card is discarded."),
        (category: Damage, name: "Structural Damage",
         text: "Ship. Your agility is reduced by 1."),

        // ---------------- Rules ----------------
        (category: Rules, name: "Round structure",
         text: "Each round: Planning (both players secretly set every ship's maneuver, action and bomb, then commit), Activation (ships move in order of pilot skill, lowest first, and take their action), Combat (ships fire in order of pilot skill, highest first) and the End phase (focus and evade tokens are removed)."),
        (category: Rules, name: "Pilot skill and initiative",
         text: "Higher pilot skill fires first and moves later. Ties are broken by the initiative token: the player with initiative moves and fires first at equal skill. Ships of equal skill fire simultaneously — a ship destroyed by an equal-skill attacker still gets its shot."),
        (category: Rules, name: "Range bands",
         text: "Range is measured between the closest points of the two bases: Range 1 up to 100 mm (2.5 units), Range 2 up to 200 mm, Range 3 up to 300 mm. Beyond Range 3 no weapon reaches. Touching bases are Range 1 but cannot shoot each other."),
        (category: Rules, name: "Range bonuses",
         text: "Primary weapons roll one extra attack die at Range 1 and the defender rolls one extra defense die at Range 3. Secondary weapons (torpedoes, missiles, cannons, turrets) get neither bonus."),
        (category: Rules, name: "Firing arc",
         text: "The 90° cone in front of a ship, measured from the center of its base. A target is in arc if any part of its base is inside the cone. Turret weapons and the YT-1300's turret primary ignore the arc."),
        (category: Rules, name: "Bullseye lane",
         text: "The strip straight ahead of a ship, as wide as its base. A defender inside the attacker's bullseye lane cannot spend focus or evade tokens against that attack (shaded amber in maneuver previews)."),
        (category: Rules, name: "Maneuver colours",
         text: "Green (blue on the dial list) maneuvers remove one stress token. White maneuvers do nothing. Red maneuvers give one stress token and cannot be planned while stressed. Crits and cards can change a maneuver's colour."),
        (category: Rules, name: "Koiogran turn (K-turn)",
         text: "Fly the straight template, then turn the ship around 180°. Red. If the final position would overlap a ship, the plain straight of the same speed is flown instead."),
        (category: Rules, name: "Tallon roll and Segnor loop",
         text: "Tallon roll: a 90° turn followed by an extra 90° pivot, ending sideways to the start heading. Segnor loop: a bank followed by a 180° pivot. Both red (Ello Asty flies Tallon rolls white while unstressed); like the K-turn they degrade to the plain turn or bank when the flipped position would overlap."),
        (category: Rules, name: "Bumping",
         text: "Ships move through each other freely; only the final position matters. If it would overlap another ship, the mover backs up along its template to the last clear spot, and forfeits its action. Ships in contact cannot attack each other."),
        (category: Rules, name: "Fleeing the board",
         text: "A ship whose base ends a maneuver or action partly off the board is destroyed."),
        (category: Rules, name: "Team play and free-for-all",
         text: "The host picks 2-4 players on the setup screen. Teams (core rules p.20): two sides, split as equally as possible (2 vs 2, or 1 vs 2 with the lone player fielding the whole side's points); every side receives the same squad points, shared out among its players; teammates deploy on the same edge, count as friendly for every card and ability, cannot be locked or targeted by each other, and win or lose together — a resigned or dropped player's ships leave the board while the teammate fights on. Free-for-all: every seat is its own side with the full points, deploying south, north, east and west in seat order; the last side with a ship in play wins. Initiative goes to the side with the lowest total; at equal pilot skill the initiative side's ships go first, then the other sides in seat order."),
        (category: Rules, name: "Obstacles: asteroids and debris",
         text: "The host chooses a scenario before creating the game: how many asteroid and debris tokens (up to 12), the squad points, the board size. Tokens are scattered at random beyond Range 1 of the edges and of each other. Ships cannot deploy, boost or barrel roll onto them. A ship whose base or template overlaps an asteroid while moving loses its action and rolls one attack die: a hit costs 1 damage, a critical a faceup damage card; a ship that ends its move on an asteroid cannot attack that round. Debris clouds instead give a stress token, and only a critical result hurts. An attack whose range line crosses an obstacle is obstructed: the defender rolls one extra die (Trick Shot gives the attacker one too)."),
        (category: Rules, name: "Black hole",
         text: "A black core one unit across with gas spiralling in. Ships cannot deploy, boost or barrel roll onto the core, and it obstructs shots like any token. After every ship has moved, each ship within Range 5 of the core is dragged one unit straight toward it (heading unchanged, stopping short of any ship in the way). A base that reaches the core is swallowed: the ship is lost."),
        (category: Rules, name: "Attack dice",
         text: "Attack dice show hit, critical hit, focus (eye) or blank. Defense dice show evade, focus or blank. Evades cancel hits first, then criticals. Cards and pilot abilities modify results before tokens are spent; see the Pilots and Upgrades tabs."),
        (category: Rules, name: "Secondary weapons",
         text: "Torpedo, missile, cannon and turret cards attack with their own dice and range band. Torpedoes and most missiles require a target lock on the target and are discarded when fired; some spend a focus token instead. Choose the weapon in the Declare Target prompt (number keys); the HUD shows which weapons are ready."),
        (category: Rules, name: "Declare Target",
         text: "When a ship has more than one legal (weapon, target) pair its owner is asked to pick; a single option is taken automatically. Highlighted ships can be clicked; the numbered list shows the weapon and the range."),
        (category: Rules, name: "Squad points",
         text: "Squads are built to 100 points from pilot costs plus upgrade costs. Unique (named) pilots and cards may appear once per squad; Limited cards once per ship."),
        (category: Rules, name: "Automated cards",
         text: "Every card is in the squad builder, but only cards marked 'automated' in this glossary are enforced by the rules engine. The others are on the roadmap; their text is shown so players can apply them by agreement."),
    ],
)

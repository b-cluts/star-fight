// Upgrade cards (First Edition), verified against the card scans in the
// gitignored reference/ clone (2026-09-02; turrets 2026-09-04). Only cards
// usable by our ships (TIE/ln, T-70, TIE/fo, Y-Wing, A-Wing) are listed, plus a few restricted ones kept for
// completeness of their slot. `cost` is squad points. `text` is the card
// wording; `effect` is the rules tag (none enforced yet, see upgrade.rs).
// Modification and Title slots are implicit on every ship.
(
    upgrades: [
        // ---------------- Torpedoes ----------------
        (id: 1, xws: "protontorpedoes", name: "Proton Torpedoes", slot: Torpedo, cost: 4,
         attack: Some((dice: 4, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(TorpedoFocusToCrit),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack. You may change 1 of your focus results to a critical hit result."),
        (id: 2, xws: "advprotontorpedoes", name: "Adv. Proton Torpedoes", slot: Torpedo, cost: 6,
         attack: Some((dice: 5, range_min: 1, range_max: 1, requires: TargetLock, discard_to_fire: true)),
         effect: Some(TorpedoBlanksToFocus),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack. You may change up to 3 of your blank results to focus results."),
        (id: 3, xws: "flechettetorpedoes", name: "Flechette Torpedoes", slot: Torpedo, cost: 2,
         attack: Some((dice: 3, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(TorpedoStressIfHullLow),
         text: "Attack (target lock): Discard this card and spend your target lock to perform this attack. After you perform this attack, the defender receives 1 stress token if its hull value is \"4\" or lower."),
        (id: 4, xws: "iontorpedoes", name: "Ion Torpedoes", slot: Torpedo, cost: 5,
         attack: Some((dice: 4, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(TorpedoIonSplash),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack. If this attack hits, the defender and each ship at Range 1 of it receives 1 ion token."),
        (id: 5, xws: "plasmatorpedoes", name: "Plasma Torpedoes", slot: Torpedo, cost: 3,
         attack: Some((dice: 4, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(TorpedoStripShield),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack. If this attack hits, after dealing damage, remove 1 shield token from the defender."),
        (id: 6, xws: "extramunitions", name: "Extra Munitions", slot: Torpedo, cost: 2, limited: true,
         effect: Some(OrdnanceTokens),
         text: "Limited. When you equip this card, place 1 ordnance token on each equipped torpedo, missile, and bomb Upgrade card. When you are instructed to discard an Upgrade card, you may discard 1 ordnance token on that card instead."),
        (id: 7, xws: "seismictorpedo", name: "Seismic Torpedo", slot: Torpedo, cost: 2,
         effect: Some(SeismicTorpedoAction),
         text: "Action: Discard this card to choose an obstacle at Range 1-2 and inside your primary firing arc. Each ship at Range 1 of the obstacle rolls 1 attack die and suffers any damage or critical damage rolled. Then remove the obstacle."),

        // ---------------- Turrets ----------------
        (id: 10, xws: "ioncannonturret", name: "Ion Cannon Turret", slot: Turret, cost: 5,
         attack: Some((dice: 3, range_min: 1, range_max: 2, requires: Free, discard_to_fire: false)),
         effect: Some(TurretIonOneDamage),
         text: "Attack: Attack 1 ship (even a ship outside your firing arc). If this attack hits the target ship, the ship suffers 1 damage and receives 1 ion token. Then cancel all dice results."),
        (id: 11, xws: "blasterturret", name: "Blaster Turret", slot: Turret, cost: 4,
         attack: Some((dice: 3, range_min: 1, range_max: 2, requires: Focus, discard_to_fire: false)),
         effect: Some(TurretBlasterSpendFocus),
         text: "Attack (focus): Spend 1 focus token to perform this attack against 1 ship (even a ship outside your firing arc)."),
        (id: 12, xws: "autoblasterturret", name: "Autoblaster Turret", slot: Turret, cost: 2,
         attack: Some((dice: 2, range_min: 1, range_max: 1, requires: Free, discard_to_fire: false)),
         effect: Some(TurretAutoblasterUncancelable),
         text: "Attack: Attack 1 ship (even a ship outside your firing arc). Your hit results cannot be canceled by defense dice. The defender may cancel critical hit results before hit results."),
        (id: 13, xws: "dorsalturret", name: "Dorsal Turret", slot: Turret, cost: 3,
         attack: Some((dice: 2, range_min: 1, range_max: 2, requires: Free, discard_to_fire: false)),
         effect: Some(TurretDorsalExtraDieAtRange1),
         text: "Attack: Attack 1 ship (even a ship outside your firing arc). If the target of this attack is at Range 1, roll 1 additional attack die."),
        (id: 14, xws: "twinlaserturret", name: "Twin Laser Turret", slot: Turret, cost: 6,
         attack: Some((dice: 3, range_min: 2, range_max: 3, requires: Free, discard_to_fire: false)),
         effect: Some(TurretTwinLaserTwiceOneDamage),
         text: "Attack: Perform this attack twice (even against a ship outside your firing arc). Each time this attack hits, the defender suffers 1 damage. Then cancel all dice results."),

        // ---------------- Missiles ----------------
        // Note for the weapon-choice step: Homing, Ion Pulse and Adv. Homing
        // need a target lock but do not spend it; Proton Rockets and XX-23
        // need a focus token but do not spend it (the card says "Discard
        // this card to perform this attack" only).
        (id: 140, xws: "concussionmissiles", name: "Concussion Missiles", slot: Missile, cost: 4,
         attack: Some((dice: 4, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(MissileBlankToHit),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack. You may change 1 of your blank results to a hit result."),
        (id: 141, xws: "clustermissiles", name: "Cluster Missiles", slot: Missile, cost: 4,
         attack: Some((dice: 3, range_min: 1, range_max: 2, requires: TargetLock, discard_to_fire: true)),
         effect: Some(MissileAttackTwice),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack twice."),
        (id: 142, xws: "homingmissiles", name: "Homing Missiles", slot: Missile, cost: 5,
         attack: Some((dice: 4, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(MissileDenyEvadeTokens),
         text: "Attack (target lock): Discard this card to perform this attack. The defender cannot spend evade tokens during this attack."),
        (id: 143, xws: "assaultmissiles", name: "Assault Missiles", slot: Missile, cost: 5,
         attack: Some((dice: 4, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(MissileSplashRange1),
         text: "Attack (target lock): Spend your target lock and discard this card to perform this attack. If this attack hits, each other ship at Range 1 of the defender suffers 1 damage."),
        (id: 144, xws: "ionpulsemissiles", name: "Ion Pulse Missiles", slot: Missile, cost: 3,
         attack: Some((dice: 3, range_min: 2, range_max: 3, requires: TargetLock, discard_to_fire: true)),
         effect: Some(MissileIonOneDamage),
         text: "Attack (target lock): Discard this card to perform this attack. If this attack hits, the defender suffers 1 damage and receives 2 ion tokens. Then cancel all dice results."),
        (id: 145, xws: "protonrockets", name: "Proton Rockets", slot: Missile, cost: 3,
         attack: Some((dice: 2, range_min: 1, range_max: 1, requires: Focus, discard_to_fire: true)),
         effect: Some(RocketExtraDiceByAgility),
         text: "Attack (focus): Discard this card to perform this attack. You may roll additional attack dice equal to your agility value, to a maximum of 3 additional dice."),
        (id: 146, xws: "advancedhomingmissiles", name: "Adv. Homing Missiles", slot: Missile, cost: 3,
         attack: Some((dice: 3, range_min: 2, range_max: 2, requires: TargetLock, discard_to_fire: true)),
         effect: Some(MissileFaceupDamage),
         text: "Attack (target lock): Discard this card to perform this attack. If this attack hits, deal 1 faceup Damage card to the defender. Then cancel all dice results."),
        (id: 147, xws: "xx23sthreadtracers", name: "XX-23 S-Thread Tracers", slot: Missile, cost: 1,
         attack: Some((dice: 3, range_min: 1, range_max: 3, requires: Focus, discard_to_fire: true)),
         effect: Some(MissileFriendsLockOnHit),
         text: "Attack (focus): Discard this card to perform this attack. If this attack hits, each friendly ship at Range 1-2 of you may acquire a target lock on the defender. Then cancel all dice results."),
        // Chardaan Refit (A-Wing only, cost -2) is not encoded: costs are
        // unsigned; add it when negative costs are supported.

        // ---------------- Tech ----------------
        (id: 20, xws: "weaponsguidance", name: "Weapons Guidance", slot: Tech, cost: 2,
         effect: Some(BlankToHitSpendFocus),
         text: "When attacking, you may spend a focus token to change 1 of your blank results to a hit result."),
        (id: 21, xws: "commrelay", name: "Comm Relay", slot: Tech, cost: 3,
         effect: Some(KeepOneEvade),
         text: "You cannot have more than 1 evade token. During the End phase, do not remove an unused evade token from your ship."),
        (id: 22, xws: "patternanalyzer", name: "Pattern Analyzer", slot: Tech, cost: 2,
         effect: Some(ResolveStressAfterAction),
         text: "When executing a maneuver, you may resolve the \"Check Pilot Stress\" step after the \"Perform Action\" step (instead of before that step)."),
        (id: 23, xws: "primedthrusters", name: "Primed Thrusters", slot: Tech, cost: 1, restrictions: [SmallShipOnly],
         effect: Some(StressAllowsRepositionUnder3),
         text: "Small ship only. Stress tokens do not prevent you from performing boost or barrel roll actions unless you have 3 or more stress tokens."),
        (id: 24, xws: "sensorcluster", name: "Sensor Cluster", slot: Tech, cost: 2,
         effect: Some(BlankToEvadeSpendFocus),
         text: "When defending, you may spend a focus token to change 1 of your blank results to an evade result."),
        (id: 25, xws: "targetingsynchronizer", name: "Targeting Synchronizer", slot: Tech, cost: 3,
         effect: Some(ShareLockWithFriendly),
         text: "When a friendly ship at Range 1-2 is attacking a ship you have locked, the friendly ship treats the \"Attack (target lock):\" header as \"Attack:\". If a game effect instructs that ship to spend a target lock, it may spend your target lock instead."),
        (id: 26, xws: "hyperwavecommscanner", name: "Hyperwave Comm Scanner", slot: Tech, cost: 1,
         effect: Some(SetupSkillOverride),
         text: "At the start of the \"Place Forces\" step, you may choose to treat your pilot skill value as \"0,\" \"6,\" or \"12\" until the end of the step. During setup, after another friendly ship is placed at Range 1-2, you may assign it 1 focus or evade token."),

        // ---------------- Astromechs ----------------
        (id: 40, xws: "bb8", name: "BB-8", slot: Astromech, cost: 2, unique: true,
         effect: Some(FreeBarrelRollOnGreen),
         text: "When you reveal a green maneuver, you may perform a free barrel roll action."),
        (id: 41, xws: "r2astromech", name: "R2 Astromech", slot: Astromech, cost: 1,
         effect: Some(Speed1And2AreGreen),
         text: "You may treat all 1- and 2-speed maneuvers as green maneuvers."),
        (id: 42, xws: "r2d2", name: "R2-D2", slot: Astromech, cost: 4, unique: true,
         effect: Some(RecoverShieldOnGreen),
         text: "After executing a green maneuver, you may recover 1 shield (up to your shield value)."),
        (id: 43, xws: "r2d6", name: "R2-D6", slot: Astromech, cost: 1, unique: true,
         restrictions: [LacksSlot(Talent), SkillAbove(2)],
         effect: Some(BarGainsTalent),
         text: "Your upgrade bar gains the elite pilot talent upgrade icon. You cannot equip this upgrade if you already have an elite pilot talent upgrade icon or if your pilot skill value is \"2\" or lower."),
        (id: 44, xws: "r2f2", name: "R2-F2", slot: Astromech, cost: 3, unique: true,
         effect: Some(AgilityPlus1Action),
         text: "Action: Increase your agility value by 1 until the end of this game round."),
        (id: 45, xws: "r3a2", name: "R3-A2", slot: Astromech, cost: 2, unique: true,
         effect: Some(StressDefenderIfInArc),
         text: "When you declare the target of your attack, if the defender is inside your firing arc, you may receive 1 stress token to cause the defender to receive 1 stress token."),
        (id: 46, xws: "r3astromech", name: "R3 Astromech", slot: Astromech, cost: 2,
         effect: Some(CancelFocusForEvade),
         text: "Once per round, when attacking with a primary weapon, you may cancel 1 of your focus results during the \"Modify Attack Dice\" step to assign 1 evade token to your ship."),
        (id: 47, xws: "r4d6", name: "R4-D6", slot: Astromech, cost: 1, unique: true,
         effect: Some(CancelHitsForStress),
         text: "When you are hit by an attack and there are at least 3 uncanceled hit results, you may choose and cancel those results until there are 2 remaining. For each result canceled in this way, receive 1 stress token."),
        (id: 48, xws: "r5astromech", name: "R5 Astromech", slot: Astromech, cost: 1,
         effect: Some(FlipShipCritFacedown),
         text: "During the End phase, you may choose 1 of your faceup Damage cards with the Ship trait and flip it facedown."),
        (id: 49, xws: "r5d8", name: "R5-D8", slot: Astromech, cost: 3, unique: true,
         effect: Some(DiscardFacedownOnDefenseDie),
         text: "Action: Roll 1 defense die. On an evade or focus result, discard 1 of your facedown Damage cards."),
        (id: 50, xws: "r5k6", name: "R5-K6", slot: Astromech, cost: 2, unique: true,
         effect: Some(ReLockOnEvadeDie),
         text: "After spending your target lock, roll 1 defense die. On an evade result, immediately acquire a target lock on that same ship. You cannot spend this target lock during this attack."),
        (id: 51, xws: "r5p9", name: "R5-P9", slot: Astromech, cost: 3, unique: true,
         effect: Some(RecoverShieldSpendFocus),
         text: "At the end of the Combat phase, you may spend 1 of your focus tokens to recover 1 shield (up to your shield value)."),
        (id: 52, xws: "r5x3", name: "R5-X3", slot: Astromech, cost: 1, unique: true,
         effect: Some(IgnoreObstaclesDiscard),
         text: "Before you reveal your maneuver, you may discard this card to ignore obstacles until the end of the round."),
        (id: 53, xws: "r7astromech", name: "R7 Astromech", slot: Astromech, cost: 2,
         effect: Some(ForceRerollWithLock),
         text: "Once per round when defending, if you have a target lock on the attacker, you may spend the target lock to choose any or all attack dice. The attacker must reroll the chosen dice."),
        (id: 54, xws: "r7t1", name: "R7-T1", slot: Astromech, cost: 3, unique: true,
         effect: Some(LockAndBoostAction),
         text: "Action: Choose an enemy ship at Range 1-2. If you are inside that ship's firing arc, you may acquire a target lock on that ship. Then, you may perform a free boost action."),
        (id: 55, xws: "targetingastromech", name: "Targeting Astromech", slot: Astromech, cost: 2,
         effect: Some(LockAfterRed),
         text: "After you execute a red maneuver, you may acquire a target lock."),
        (id: 56, xws: "m9g8", name: "M9-G8", slot: Astromech, cost: 3, unique: true,
         effect: Some(ForceRerollLockedAttacker),
         text: "When a ship you have locked is attacking, you may choose 1 attack die. The attacker must reroll that die. You can acquire target locks on other friendly ships."),

        // ---------------- Modifications ----------------
        (id: 70, xws: "hullupgrade", name: "Hull Upgrade", slot: Modification, cost: 3,
         effect: Some(HullPlus1), text: "Modification. Increase your hull value by 1."),
        (id: 71, xws: "shieldupgrade", name: "Shield Upgrade", slot: Modification, cost: 4,
         effect: Some(ShieldPlus1), text: "Modification. Increase your shield value by 1."),
        (id: 72, xws: "stealthdevice", name: "Stealth Device", slot: Modification, cost: 3,
         effect: Some(AgilityPlus1DiscardWhenHit),
         text: "Modification. Increase your agility value by 1. If you are hit by an attack, discard this card."),
        (id: 73, xws: "targetingcomputer", name: "Targeting Computer", slot: Modification, cost: 2,
         effect: Some(BarGainsTargetLock), text: "Modification. Your action bar gains the target lock action icon."),
        (id: 74, xws: "engineupgrade", name: "Engine Upgrade", slot: Modification, cost: 4,
         effect: Some(BarGainsBoost), text: "Modification. Your action bar gains the boost action icon."),
        (id: 75, xws: "autothrusters", name: "Autothrusters", slot: Modification, cost: 2,
         restrictions: [RequiresAction(Boost)],
         effect: Some(BlankToEvadeAtRange3OrOutsideArc),
         text: "Modification. When defending, if you are beyond Range 2 or outside the attacker's firing arc, you may change 1 of your blank results to an evade result. You can equip this card only if you have the boost action icon."),
        (id: 76, xws: "integratedastromech", name: "Integrated Astromech", slot: Modification, cost: 0,
         restrictions: [ShipOnly("xwing")],
         effect: Some(DiscardAstromechToCancelDamage),
         text: "X-wing only. Modification. When you are dealt a Damage card, you may discard 1 of your astromech Upgrade cards to discard that Damage card (without resolving its effect)."),
        (id: 77, xws: "guidancechips", name: "Guidance Chips", slot: Modification, cost: 0,
         effect: Some(OrdnanceDieToHit),
         text: "Modification. Once per round, when attacking with a torpedo or missile secondary weapon, you may change 1 die result to a hit result (or a critical hit result if your primary weapon value is \"3\" or higher)."),
        (id: 78, xws: "twinionenginemkii", name: "Twin Ion Engine Mk. II", slot: Modification, cost: 1,
         restrictions: [ShipOnly("tie")],
         effect: Some(BanksAreGreen),
         text: "TIE only. Modification. You may treat all bank maneuvers as green maneuvers."),
        (id: 79, xws: "lightweightframe", name: "Lightweight Frame", slot: Modification, cost: 2,
         restrictions: [ShipOnly("tie"), AgilityBelow(3)],
         effect: Some(ExtraDefenseDieIfOutgunned),
         text: "TIE only. Modification. When defending, after rolling defense dice, if there are more attack dice than defense dice, roll 1 additional defense die. You cannot equip this card if your agility value is \"3\" or higher."),
        (id: 80, xws: "vectoredthrusters", name: "Vectored Thrusters", slot: Modification, cost: 2,
         restrictions: [SmallShipOnly],
         effect: Some(BarGainsBarrelRoll),
         text: "Small ship only. Modification. Your action bar gains the barrel roll action icon."),
        (id: 81, xws: "munitionsfailsafe", name: "Munitions Failsafe", slot: Modification, cost: 1,
         effect: Some(KeepOrdnanceOnMiss),
         text: "Modification. When attacking with a secondary weapon that instructs you to discard it to perform the attack, do not discard it unless the attack hits."),
        (id: 82, xws: "experimentalinterface", name: "Experimental Interface", slot: Modification, cost: 3, unique: true,
         effect: Some(ExtraActionThenStress),
         text: "Modification. Once per round, after you perform an action, you may perform 1 free action from an equipped Upgrade card with the \"Action:\" header. Then receive 1 stress token."),
        (id: 83, xws: "longrangescanners", name: "Long-Range Scanners", slot: Modification, cost: 0,
         restrictions: [RequiresSlots([Torpedo, Missile])],
         effect: Some(LocksOnlyAtRange3),
         text: "Modification. You can acquire target locks on ships at Range 3 and beyond. You cannot acquire target locks on ships at Range 1-2. You can equip this card only if you have torpedo and missile icons in your upgrade bar."),

        // ---------------- Titles ----------------
        (id: 90, xws: "blackone", name: "Black One", slot: Title, cost: 1, unique: true,
         restrictions: [ShipOnly("t70xwing"), SkillAbove(6)],
         effect: Some(RemoveEnemyLockAfterReposition),
         text: "T-70 X-wing only. Title. After you perform a boost or barrel roll action, you may remove 1 enemy target lock from a friendly ship at Range 1. You cannot equip this card if your pilot skill is \"6\" or lower."),

        (id: 91, xws: "awingtestpilot", name: "A-Wing Test Pilot", slot: Title, cost: 0,
         restrictions: [ShipOnly("awing"), SkillAbove(1)],
         effect: Some(BarGainsTalent),
         text: "A-Wing only. Title. Your upgrade bar gains 1 Elite upgrade icon. You cannot equip 2 of the same Elite Upgrade cards. You cannot equip this card if your pilot skill value is \"1\" or lower."),
        (id: 92, xws: "btla4ywing", name: "BTL-A4 Y-Wing", slot: Title, cost: 0,
         restrictions: [ShipOnly("ywing")],
         effect: Some(TitleArcOnlyThenTurretAttack),
         text: "Y-Wing only. Title. You cannot attack ships outside your firing arc. After you perform a primary weapon attack, you may immediately perform an attack with a Turret secondary weapon."),

        // ---------------- Elite Pilot Talents ----------------
        (id: 100, xws: "wired", name: "Wired", slot: Talent, cost: 1,
         effect: Some(RerollFocusWhenStressed),
         text: "When attacking or defending, if you are stressed, you may reroll 1 or more of your focus results."),
        (id: 101, xws: "predator", name: "Predator", slot: Talent, cost: 3,
         effect: Some(RerollOneAttackDie),
         text: "When attacking, you may reroll 1 attack die. If the defender's pilot skill value is \"2\" or lower, you may instead reroll up to 2 attack dice."),
        (id: 102, xws: "pushthelimit", name: "Push the Limit", slot: Talent, cost: 3,
         effect: Some(FreeActionThenStress),
         text: "Once per round, after you perform an action, you may perform 1 free action shown in your action bar. Then receive 1 stress token."),
        (id: 103, xws: "veteraninstincts", name: "Veteran Instincts", slot: Talent, cost: 1,
         effect: Some(SkillPlus2), text: "Increase your pilot skill value by 2."),
        (id: 104, xws: "lonewolf", name: "Lone Wolf", slot: Talent, cost: 2, unique: true,
         effect: Some(RerollBlankIfAlone),
         text: "When attacking or defending, if there are no friendly ships at Range 1-2, you may reroll 1 of your blank results."),
        (id: 105, xws: "crackshot", name: "Crack Shot", slot: Talent, cost: 1,
         effect: Some(CancelEvadeDiscard),
         text: "When attacking a ship inside your firing arc, you may discard this card to cancel 1 of the defender's evade results."),
        (id: 106, xws: "juke", name: "Juke", slot: Talent, cost: 2, restrictions: [SmallShipOnly],
         effect: Some(EvadeToFocusIfEvadeToken),
         text: "Small ship only. When attacking, if you have an evade token, you may change 1 of the defender's evade results to a focus result."),
        // Dual card: one face per entry (the builder offers both).
        (id: 107, xws: "adaptabilityincrease", name: "Adaptability (+1)", slot: Talent, cost: 0,
         effect: Some(SkillPlus1),
         text: "Dual card. Increase your pilot skill value by 1."),
        (id: 135, xws: "adaptabilitydecrease", name: "Adaptability (-1)", slot: Talent, cost: 0,
         effect: Some(SkillMinus1),
         text: "Dual card. Decrease your pilot skill value by 1."),
        (id: 108, xws: "marksmanship", name: "Marksmanship", slot: Talent, cost: 3,
         effect: Some(FocusToCritOthersToHitAction),
         text: "Action: When attacking this round, you may change 1 of your focus results to a critical hit result and all of your other focus results to hit results."),
        (id: 109, xws: "determination", name: "Determination", slot: Talent, cost: 1,
         effect: Some(DiscardPilotCritImmediately),
         text: "When you are dealt a faceup Damage card with the Pilot trait, discard it immediately without resolving its effect."),
        (id: 110, xws: "swarmtactics", name: "Swarm Tactics", slot: Talent, cost: 2,
         effect: Some(ShareSkillWithFriendly),
         text: "At the start of the Combat phase, choose 1 friendly ship at Range 1. Until the end of this phase, treat the chosen ship as if its pilot skill were equal to your pilot skill."),
        (id: 111, xws: "squadleader", name: "Squad Leader", slot: Talent, cost: 2, unique: true,
         effect: Some(FreeActionForLowerSkillShip),
         text: "Action: Choose 1 ship at Range 1-2 that has a lower pilot skill than you. The chosen ship may immediately perform 1 free action."),
        (id: 112, xws: "expose", name: "Expose", slot: Talent, cost: 4,
         effect: Some(ExposeAction),
         text: "Action: Until the end of the round, increase your primary weapon value by 1 and decrease your agility value by 1."),
        (id: 113, xws: "elusiveness", name: "Elusiveness", slot: Talent, cost: 2,
         effect: Some(ForceRerollForStress),
         text: "When defending, you may receive 1 stress token to choose 1 attack die. The attacker must reroll that die. If you have at least 1 stress token, you cannot use this ability."),
        (id: 114, xws: "adrenalinerush", name: "Adrenaline Rush", slot: Talent, cost: 1,
         effect: Some(TreatRedAsWhiteDiscard),
         text: "When you reveal a red maneuver, you may discard this card to treat that maneuver as a white maneuver until the end of the Activation phase."),
        (id: 115, xws: "ascoretosettle", name: "A Score to Settle", slot: Talent, cost: 0, unique: true,
         effect: Some(ScoreToSettle),
         text: "During setup, before the \"Place Forces\" step, choose 1 enemy ship and assign the \"A Debt to Pay\" Condition card to it. When attacking a ship that has the \"A Debt to Pay\" Condition card, you may change 1 focus result to a critical hit result."),
        (id: 116, xws: "calculation", name: "Calculation", slot: Talent, cost: 1,
         effect: Some(FocusToCritSpendFocus),
         text: "When attacking, you may spend a focus token to change 1 of your focus results to a critical hit result."),

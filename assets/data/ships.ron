// Ship classes. footprint is (length, width) in game units; anchor_px is
// the sprite pixel that maps onto the ship's front-center anchor (the
// sprite faces UP, so that's top-center of the artwork).
(
    classes: [
        (
            id: 1,
            name: "TIE Fighter",
            size: Small,
            footprint: (length: 1.0, width: 1.0), // small base: 40 x 40 mm
            maneuver_set: 1,
            attack_dice: 2,
            pilot_skill: 1,
            agility: 3, // no shields — dodging is all it has
            hull: 3,
            shields: 0,
            squad_points: 12, // provisional

            sprite: "ships/tie-fighter.png",
            sprite_px: (461, 566),
            // Wings reach the top edge, so the ship's front line is y = 0
            // at the horizontal center.
            anchor_px: (230, 0),
            portrait: Some("portraits/tie-fighter.png"),
        ),
        (
            id: 2,
            name: "X-Wing T-70",
            size: Small,
            footprint: (length: 1.0, width: 1.0), // small base: 40 x 40 mm
            maneuver_set: 2,
            attack_dice: 3,
            pilot_skill: 2,
            agility: 2,
            hull: 3,
            shields: 3,
            squad_points: 24, // provisional

            sprite: "ships/xwing-t70.png",
            sprite_px: (720, 809),
            // Nose tip measured at pixel row 1, centered on x = 362.
            anchor_px: (362, 1),
            portrait: None,
        ),
    ],
)

// Ship classes. footprint is (length, width) in game units; anchor_px is
// the sprite pixel that maps onto the ship's front-center anchor (the
// sprite faces UP, so that's top-center of the artwork).
(
    classes: [
        (
            id: 1,
            name: "TIE Fighter",
            xws: "tiefighter",
            faction: Empire,
            size: Small,
            footprint: (length: 1.0, width: 1.0), // small base: 40 x 40 mm
            maneuver_set: 1,
            attack_dice: 2,
            agility: 3, // no shields — dodging is all it has
            hull: 3,
            shields: 0,
            action_bar: [Focus, BarrelRoll, Evade],
            upgrade_bar: [],

            sprite: "ships/tie-fighter.png",
            sprite_px: (461, 566),
            // Wings reach the top edge, so the ship's front line is y = 0
            // at the horizontal center.
            anchor_px: (230, 0),
            portrait: Some("portraits/tie-fighter.png"),
        ),
        (
            id: 2,
            name: "X-Wing T-70",
            xws: "t70xwing",
            faction: RebelAlliance,
            size: Small,
            footprint: (length: 1.0, width: 1.0), // small base: 40 x 40 mm
            maneuver_set: 2,
            attack_dice: 3,
            agility: 2,
            hull: 3,
            shields: 3,
            // First Edition T-70: no native barrel roll.
            action_bar: [Focus, TargetLock, Boost],
            upgrade_bar: [Astromech, Torpedo, Tech],

            sprite: "ships/xwing-t70.png",
            sprite_px: (720, 809),
            // Nose tip measured at pixel row 1, centered on x = 362.
            anchor_px: (362, 1),
            portrait: None,
        ),
        (
            id: 3,
            name: "TIE/fo Fighter",
            xws: "tiefofighter",
            faction: Empire, // First Order
            size: Small,
            footprint: (length: 1.0, width: 1.0),
            maneuver_set: 3,
            attack_dice: 2,
            agility: 3,
            hull: 3,
            shields: 1,
            action_bar: [Focus, TargetLock, BarrelRoll, Evade],
            upgrade_bar: [Tech],

            // Placeholder art: shares the TIE/ln sprite until its own lands.
            sprite: "ships/tie-fighter.png",
            sprite_px: (461, 566),
            anchor_px: (230, 0),
            portrait: Some("portraits/tie-fighter.png"),
        ),
    ],
)
